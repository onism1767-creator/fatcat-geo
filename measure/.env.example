# 复制本文件为 .env 并填入真实值。.env 已在 .gitignore 中,永不入库。
# 不要把任何 key 粘贴到对话 / 聊天记录里。
# 写法:KEY=值;值两边加不加引号都行,# 后面是注释。

# 四家 AI 的 API key:有哪家填哪家,空着的那家开跑时自动跳过(至少填一家)。
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# 可选增强:Reddit 官方接口(不填就走公开嵌入接口)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=

# 本机项目专用库(scripts/pgdev.ps1 创建,trust 认证无密码);不填也行,默认就是这个
GEO_DATABASE_URL=postgresql://geo@localhost:5433/geo_toast
