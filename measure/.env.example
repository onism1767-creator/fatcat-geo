# 复制本文件为 .env 并填入真实值。.env 已在 .gitignore 中,永不入库。
# 不要把任何 key 粘贴到对话/聊天记录里。

# Perplexity API key(https://www.perplexity.ai/settings/api)
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxx

# 其余适配器落地时才需要:
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# 本地开发库(scripts/pgdev.ps1 创建的项目专用实例,trust 认证无密码)
GEO_DATABASE_URL=postgresql://geo@localhost:5433/geo_tool
